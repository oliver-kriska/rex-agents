#!/bin/sh
# rex-agents: thin wrapper. The logic is Lua (rex-agents/cli.lua), run by `rex do`.
# Arguments travel in REX_AGENTS_ARGV, separated by \037, so they arrive exactly as typed.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
dir=${REX_AGENTS_DIR:-$(cd "$(dirname "$self")/../rex-agents" && pwd)}

rex=$(command -v rex 2>/dev/null)
[ -n "$rex" ] || rex="$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"

# Pin the server with -S: if REX_SERVER names a server that is not answering, rex would
# otherwise fall back to the home server. Inside a Rex pane, REX_SERVER is that pane's server.
REX_AGENTS_SERVER=${REX_AGENTS_SERVER:-$REX_SERVER}
REX_AGENTS_ARGV=$(printf '%s\037' "$@")
export REX_AGENTS_ARGV REX_AGENTS_SERVER
if [ -n "$REX_AGENTS_SERVER" ]; then
  exec "$rex" --autostart=false -S "$REX_AGENTS_SERVER" do "$dir/cli.lua"
fi
exec "$rex" --autostart=false do "$dir/cli.lua"
